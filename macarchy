#!/bin/bash
#
# macarchy -- randomize or restore a network interface's MAC address, from
# the Omarchy bar.
#
# Structure mirrors tormarchy (https://github.com/TripleU613/tormarchy):
# one script, dispatched by subcommand. Unlike tormarchy, nothing is
# installed system-wide and this script never runs as root. Reading state
# is unprivileged. On NetworkManager-managed interfaces changes go through
# NM itself, also unprivileged (apply_mac_nm). Only on interfaces nothing
# manages is root needed, and then only for `ip link set` handed to sudo
# (terminal) or pkexec (bar click) with plain, validated arguments -- see
# as_root(). There is no setup step, no polkit policy or rule, and no
# package installation.

set -uo pipefail

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

umask 077

# Only ever the argv[0] of a privileged call -- a distro-owned binary from
# the signed iproute2 package. Nothing from this checkout (this script
# included) ever runs as root.
IP=/usr/bin/ip

die() { echo "macarchy: $*" >&2; exit 1; }

# The privilege boundary, and the only one. Runs a single fixed,
# package-owned binary with plain arguments as root: sudo from a real
# terminal, pkexec otherwise (a bar click has no stdin tty to prompt on).
# No polkit policy or rule of our own is installed, so pkexec falls back
# to its stock admin-auth action and shows the exact command it is about
# to run in the prompt. Every argument has been validated before it gets
# here (iface_exists / is_valid_mac).
as_root() {
  [[ $1 == "$IP" ]] || die "internal error: refusing to elevate $1"
  if [[ -t 0 ]]; then
    sudo -- "$@"
  else
    pkexec "$@"
  fi
}

# Hardware-backed ethernet-type interfaces only -- a /sys device link
# excludes lo, tun/wg, docker bridges and veths, none of which have a
# permanent address to restore to.
real_interfaces() {
  local path iface
  for path in /sys/class/net/*; do
    iface=${path##*/}
    [[ -e $path/device && $(<"$path/type") == 1 ]] || continue
    printf '%s\n' "$iface"
  done
}

iface_exists() {
  local iface="$1"
  real_interfaces | grep -qx -- "$iface"
}

# Prints "<current>\t<permanent>" for one interface. iproute2 only prints
# `permaddr` when it differs from the current address, so its absence
# means the interface is on its permanent MAC.
iface_macs() {
  local iface="$1" line current permanent
  line=$("$IP" -o link show dev "$iface" 2>/dev/null) || return 1
  current=$(sed -nE 's/.*link\/ether ([0-9a-f:]{17}).*/\1/p' <<<"$line")
  permanent=$(sed -nE 's/.*permaddr ([0-9a-f:]{17}).*/\1/p' <<<"$line")
  [[ -n $current ]] || return 1
  printf '%s\t%s\n' "$current" "${permanent:-$current}"
}

is_randomized() {
  local iface="$1" current permanent
  IFS=$'\t' read -r current permanent < <(iface_macs "$iface") || return 1
  [[ $current != "$permanent" ]]
}

# Locally administered (bit 1 set), unicast (bit 0 clear) -- the same
# class of address macchanger -r and NetworkManager's random mode produce.
random_mac() {
  local -a b
  read -r -a b < <(od -An -N6 -tu1 /dev/urandom)
  printf '%02x:%02x:%02x:%02x:%02x:%02x\n' \
    $(( (b[0] & 0xfc) | 0x02 )) "${b[1]}" "${b[2]}" "${b[3]}" "${b[4]}" "${b[5]}"
}

nm_state() {
  command -v nmcli >/dev/null 2>&1 || return 0
  nmcli -t -f DEVICE,STATE device status 2>/dev/null | awk -F: -v d="$1" '$1==d{print $2}'
}

apply_mac() {
  local iface="$1" mac="$2" state
  is_valid_mac "$mac" || die "invalid MAC address: $mac"
  state=$(nm_state "$iface")
  if [[ -n $state && $state != "unmanaged" ]]; then
    apply_mac_nm "$iface" "$mac"
  else
    apply_mac_ip "$iface" "$mac"
  fi
}

# NetworkManager-managed interfaces: an address set underneath NM doesn't
# last -- on the next activation it resets the MAC to the one it recorded
# when it took the device over (confirmed live: "set-hw-addr: reset MAC
# address to ... (preserve)"), and NM refuses to reapply a changed MAC
# onto a live connection. So the change goes on the active connection
# profile's cloned-mac-address, and the connection is brought back up.
# Both steps are ordinary NM polkit actions a local active user already
# holds -- no root, no prompt. Restoring clears the property rather than
# pinning the permanent address, returning the profile to NM's default.
apply_mac_nm() {
  local iface="$1" mac="${2,,}" uuid prop value
  uuid=$(nmcli -g GENERAL.CON-UUID device show "$iface" 2>/dev/null)
  [[ -n $uuid ]] || die "$iface is managed by NetworkManager but not connected -- connect it first"
  case $(nmcli -g connection.type connection show uuid "$uuid" 2>/dev/null) in
  802-11-wireless) prop=802-11-wireless.cloned-mac-address ;;
  802-3-ethernet)  prop=802-3-ethernet.cloned-mac-address ;;
  *) die "$iface's active connection is not wifi or ethernet" ;;
  esac
  value=$mac
  [[ $mac == "$(permanent_mac "$iface")" ]] && value=""
  nmcli connection modify uuid "$uuid" "$prop" "$value" \
    || die "NetworkManager refused to change $iface's MAC"
  nmcli connection up uuid "$uuid" >/dev/null \
    || die "changed $iface's MAC setting, but it did not reconnect"
}

# Interfaces nothing else manages. Most drivers refuse an address change on
# a live link ("Device or resource busy"), and the kernel applies a new
# address before a flag change within one request, so this takes two
# privileged calls: link down, then address + link up together.
apply_mac_ip() {
  local iface="$1" mac="$2"
  as_root "$IP" link set dev "$iface" down \
    || die "could not take $iface down (prompt cancelled?)"
  if ! as_root "$IP" link set dev "$iface" address "$mac" up; then
    # The link is down now -- don't leave it that way.
    as_root "$IP" link set dev "$iface" up >/dev/null 2>&1
    die "could not set $iface to $mac"
  fi
}

permanent_mac() {
  local current permanent
  IFS=$'\t' read -r current permanent < <(iface_macs "$1") \
    || die "cannot read the permanent MAC of $1"
  printf '%s\n' "$permanent"
}

MAC_RE='^[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}$'

is_valid_mac() {
  [[ $1 =~ $MAC_RE ]]
}

cmd_status() {
  local json="${1:-}" first=1 iface current permanent randomized

  if [[ $json == --json ]]; then
    printf '{\n  "interfaces": [\n'
    while IFS= read -r iface; do
      [[ -n $iface ]] || continue
      IFS=$'\t' read -r current permanent < <(iface_macs "$iface") || continue
      randomized=false
      [[ $current != "$permanent" ]] && randomized=true
      (( first )) || printf ',\n'
      first=0
      printf '    {"iface": "%s", "current": "%s", "permanent": "%s", "randomized": %s}' \
        "$iface" "$current" "$permanent" "$randomized"
    done < <(real_interfaces)
    printf '\n  ]\n}\n'
    return 0
  fi

  while IFS= read -r iface; do
    [[ -n $iface ]] || continue
    IFS=$'\t' read -r current permanent < <(iface_macs "$iface") || { echo "$iface: unreadable"; continue; }
    if [[ $current != "$permanent" ]]; then
      echo "$iface: randomized ($current, permanent is $permanent)"
    else
      echo "$iface: permanent ($permanent)"
    fi
  done < <(real_interfaces)
}

cmd_randomize() {
  local iface="${1:?usage: macarchy randomize <iface>}"
  iface_exists "$iface" || die "no such interface: $iface"
  apply_mac "$iface" "$(random_mac)"
  echo "Randomized $iface."
}

cmd_restore() {
  local iface="${1:?usage: macarchy restore <iface>}"
  iface_exists "$iface" || die "no such interface: $iface"
  if ! is_randomized "$iface"; then
    echo "$iface is already on its permanent MAC."
    return 0
  fi
  apply_mac "$iface" "$(permanent_mac "$iface")"
  echo "Restored $iface to its permanent MAC."
}

# A specific address rather than a random one -- validated before anything
# is elevated so a malformed address never reaches the privileged call.
cmd_set() {
  local iface="${1:?usage: macarchy set <iface> <mac>}"
  local mac="${2:?usage: macarchy set <iface> <mac>}"
  iface_exists "$iface" || die "no such interface: $iface"
  is_valid_mac "$mac" || die "invalid MAC address: $mac (expected xx:xx:xx:xx:xx:xx)"
  apply_mac "$iface" "$mac"
  echo "Set $iface to $mac."
}

# Flips based on current state, since a single bar click / menu action
# can't branch on state itself.
cmd_toggle() {
  local iface="${1:?usage: macarchy toggle <iface>}"
  iface_exists "$iface" || die "no such interface: $iface"
  if is_randomized "$iface"; then
    cmd_restore "$iface"
  else
    cmd_randomize "$iface"
  fi
}

# The escape hatch: every real interface back to its permanent MAC.
cmd_panic() {
  local iface any=0
  while IFS= read -r iface; do
    [[ -n $iface ]] || continue
    if is_randomized "$iface"; then
      cmd_restore "$iface"
      any=1
    fi
  done < <(real_interfaces)
  (( any )) || echo "Nothing was randomized."
}

cmd_help() {
  cat <<USAGE
macarchy -- randomize or restore a network interface's MAC address, from
the Omarchy bar.

  status [--json]        Current state of every real interface.
  randomize <iface>      Randomize one interface's MAC.
  restore <iface>        Restore one interface's permanent MAC.
  set <iface> <mac>      Set one interface to a specific MAC address.
  toggle <iface>         Flip between randomized and permanent.
  panic                  Restore every interface at once.

Never run this with sudo. Interfaces NetworkManager manages change
without a password. Any other interface asks for it (sudo in a terminal,
a polkit prompt otherwise) only for the \`ip link set\` calls themselves.
USAGE
}

(( EUID != 0 )) || die "don't run macarchy as root -- it asks for your password only for the ip call that needs it"

command="${1:-help}"
shift || true

case "$command" in
status)     cmd_status "$@" ;;
randomize)  cmd_randomize "$@" ;;
restore)    cmd_restore "$@" ;;
set)        cmd_set "$@" ;;
toggle)     cmd_toggle "$@" ;;
panic)      cmd_panic "$@" ;;
help | -h | --help) cmd_help ;;
*)          cmd_help >&2; die "unknown command: $command" ;;
esac
